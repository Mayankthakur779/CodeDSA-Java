class Solution {
    public int scoreOfParentheses(String s) {
        Stack<Integer> st = new Stack<>();
        st.push(0);

        for (char ch : s.toCharArray()) {
            if (ch == '(') {
                st.push(0);
            } else {
                int x = st.pop();
                int score = (x == 0) ? 1 : 2 * x;

                int top = st.pop();
                st.push(top + score);
            }
        }

        return st.pop();
    }
}
