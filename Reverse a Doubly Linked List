/* Structure of Doubly Linked List Node
class Node {
    int data;
    Node next;
    Node prev;

    Node(int data) {
        this.data = data;
        this.next = null;
        this.prev = null;
    }
}
*/
class Solution {
    public Node reverse(Node head) {
        // code here
        if (head.next==null) return head;
        Node temp=null;
        Node curr=head;
        
        while(curr!=null){
            temp = curr.prev;
            curr.prev=curr.next;
            curr.next=temp; //added line
        
            curr=curr.prev;
        }
        return temp.prev;
    }
}
